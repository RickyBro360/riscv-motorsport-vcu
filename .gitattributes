# Normalise line endings for text, keep binaries untouched
* text=auto
*.ino  text eol=lf
*.h    text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.pdf  binary
*.png  binary
*.jpg  binary
*.gbr  text
*.drl  text

